@model Savemor.Models.ProductsPageViewModel

@{
    ViewBag.Title = "Products";
    
    // Turn this list of categories into an actual list (Inherits from IEnumerable)
    var ProductList = Model.ShortProductInfo.ToList();
    var CategoryList = Model.Category.ToList();
}
<table class="CategoryMenu">
	<tr class="emptyrow">
        <td class="emptycell">&nbsp;</td>
	</tr>
    <tr>
		<td class="CategorySpace">&nbsp;</td>
            @for (int i=0; i< Model.Category.Count(); i++)
        {
		    <td class="CategoryItem"><a href="@Url.Action("Index", "Products", new RouteValueDictionary(new { CategoryID = CategoryList[i].ID.ToString() }))">@CategoryList[i].Name</a></td>
        }
        <td class="CategoryItem"><a href="@Url.Action("Services","Home")">Free Services</a></td>
		<td class="CategorySpace">&nbsp;</td>
	</tr>
</table>
<table class="products">
    <tr class="productspagingbar">
        <td class="productspagingbar" colspan="4">Showing 1-@ProductList.Count of @ProductList.Count products</td>
        <td class="productsdropdownbox">
            <select class="SelectionDropdownBox">
                <option value="ViewAll" selected="selected">View All</option>
                <option value="Condition">Condition</option>
                <option value="BrandName">Brand name</option>
                <option value="Category">Category</option>
            </select>
        </td>
    </tr>
    <tr class="greenbackground">
        <td colspan="4" class="topborder4columns">&nbsp;</td>
        <td rowspan="999" class="selectionlist">
            <div class="selectionlist">
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
                Antioxidants<br />
            </div>
        </td>
    </tr>
    @{
        for (int i = 0; i <= ProductList.Count - 1; i += 4)
        { 
            <tr>
                @{
                    for (int j = i; j < i + 4; j++)
                    {
                        if (j< ProductList.Count)
                        {
                            <td class="productimage">
                                <a href="@Url.Action("Product", "Products", new RouteValueDictionary(new { ProductID = ProductList[j].ID }))">
                                    <img class="productmedium" src="@Html.DisplayFor(modelItem => ProductList[j].Image)" alt="@Html.DisplayFor(modelItem => ProductList[j].Name) image" />
                                </a>
                            </td>
                        }
                    }
                }
            </tr>
            <tr>
                @{
                    for (int j = i; j < i + 4; j++)
                    {
                        if (j< ProductList.Count)
                        {
                            <td class="productname">
                                <span class="productname">@Html.DisplayFor(modelItem => ProductList[j].Name)</span>
                            </td>       
                        }
                    }
                }
            </tr>
            <tr>
                @{
                    for (int j = i; j < i + 4; j++)
                    {
                        if (j< ProductList.Count)
                        {
                            <td class="productinfo">
                                @{
                                    decimal Price = ProductList[j].Price;
                                    decimal RecommendedPrice = ProductList[j].RecommendedPrice;
                                    decimal Saving = RecommendedPrice - Price;
                                    string SaveText = "Save up to $" + Saving;
                            
                                    if (Saving <= 0m) 
                                    {
                                        SaveText = "";
                                    }
                            
                                    <span class="productprice">Our price: $@Html.DisplayFor(modelItem => ProductList[j].Price)</span><br />
                                    <span class="saveamount">@SaveText</span><br />
                                    <br />
                                    <span class="productbuttons">
								        <a href="#"><img class="productbutton" src="../images/RP_menu.png" /></a>
								        <a href="#"><img class="productbutton" src="../images/SP_menu.png" /></a>
								        <a href="#"><img class="productbutton" src="../images/MI_menu.png" /></a>
								        <a href="#"><img class="productbutton" src="../images/ATC_menu.png" /></a>
							        </span>
                                }        
                            </td>
                        }
                    }
                }
            </tr>
        }
    }
    <tr>
        <td>&nbsp;</td>
    </tr>
</table>

